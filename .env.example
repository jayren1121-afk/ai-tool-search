# Supabase → Project Settings → API（公開，可用於瀏覽器）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 僅限伺服器！切勿加上 NEXT_PUBLIC_ 前綴
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Google AI Studio → Get API key
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
# Tavily 免費方案（約每月 1,000 點）。只在伺服器使用，不要加 NEXT_PUBLIC_。
# 未命中快取的站外搜尋，全站每天最多 30 次。沒有這把鑰匙時，搜尋只顯示站內目錄。
TAVILY_API_KEY=
# 站外結果「+ 建議給管理員」的 HMAC 密鑰（只在伺服器，不要加 NEXT_PUBLIC_）。
# 簽的是「網址 + 換行 + 標題」，用來擋掉客戶端自填的網址。
# 沒設這一行時，依序改用 IP_HASH_SALT、ADMIN_SESSION_SECRET、SUPABASE_SERVICE_ROLE_KEY。
# 正式環境四個都沒有時，「+」不會出現，/api/suggestions 會回 503。
# 本機開發四個都沒有時，用這次行程裡的隨機密鑰（重開就換，不能當正式密鑰）。
SUGGESTION_SIGNING_SECRET=
# 核准建議、寫入目錄時使用既有的 GROQ_API_KEY（預設 openai/gpt-oss-120b），
# 失敗再改 OPENROUTER_API_KEY（預設免費模型）。這一步不讀 GEMINI_API_KEY。
